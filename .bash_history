# 1. Create folder named 'app'
mkdir app
# 2. Create app.py file INSIDE app folder
cd app
touch app.py
# 3. Add sample code to app.py (Flask web app example)
cat > app.py << 'EOF'
from flask import Flask
import os

app = Flask(__name__)

@app.route('/')
def hello():
    return f"""
    <h1>Hello from Local App! 🐍</h1>
    <p>Current directory: {os.getcwd()}</p>
    <p>You're running app.py successfully! 🎉</p>
    """

@app.route('/health')
def health():
    return {"status": "healthy", "path": os.getcwd()}

if __name__ == '__main__':
    print("Starting app on http://localhost:5000")
    app.run(host='0.0.0.0', port=5000, debug=True)
EOF

# 4. Install Flask (if needed)
